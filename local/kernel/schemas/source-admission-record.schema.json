{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "filmstack-source-admission-record/v1",
  "title": "FilmStack Proof-Carrying Source Admission Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "admission_record_id",
    "admission_record_hash",
    "admission_candidate_id",
    "admission_candidate_hash",
    "observation_id",
    "observation_hash",
    "verification_report_id",
    "verification_report_hash",
    "blob_sha256",
    "byte_length",
    "title_id",
    "base_state_version",
    "base_state_hash",
    "policy_version",
    "policy_hash",
    "revision_id",
    "source_title",
    "declared_format",
    "admitted_by_actor_id",
    "source_authority_actor_id",
    "source_authority_record_id",
    "source_authority_record_hash",
    "intentional_export_attestor_id",
    "intentional_export_attestation_id",
    "intentional_export_attestation_hash",
    "creative_approver_id",
    "creative_approval_id",
    "creative_approval_hash",
    "title_revision_identity_reviewer_id",
    "title_revision_identity_record_id",
    "title_revision_identity_record_hash",
    "rights_controller_id",
    "rights_basis_kind",
    "rights_record_id",
    "rights_record_hash",
    "admitted_evidence",
    "decision",
    "decision_reason_codes",
    "decision_state",
    "production_gate_effect",
    "admitted_at_ms"
  ],
  "properties": {
    "schema_version": { "const": "filmstack-source-admission-record/v1" },
    "admission_record_id": { "$ref": "#/$defs/id" },
    "admission_record_hash": { "$ref": "#/$defs/sha256" },
    "admission_candidate_id": { "$ref": "#/$defs/id" },
    "admission_candidate_hash": { "$ref": "#/$defs/sha256" },
    "observation_id": { "$ref": "#/$defs/id" },
    "observation_hash": { "$ref": "#/$defs/sha256" },
    "verification_report_id": { "$ref": "#/$defs/id" },
    "verification_report_hash": { "$ref": "#/$defs/sha256" },
    "blob_sha256": { "$ref": "#/$defs/sha256" },
    "byte_length": { "type": "integer", "minimum": 1, "maximum": 268435456 },
    "title_id": { "$ref": "#/$defs/id" },
    "base_state_version": { "$ref": "#/$defs/time" },
    "base_state_hash": { "$ref": "#/$defs/sha256" },
    "policy_version": { "$ref": "#/$defs/id" },
    "policy_hash": { "$ref": "#/$defs/sha256" },
    "revision_id": { "$ref": "#/$defs/id" },
    "source_title": { "type": "string", "minLength": 1, "maxLength": 512 },
    "declared_format": { "enum": ["FDX", "FOUNTAIN", "PDF", "DOCX", "TXT", "RTF", "OTHER"] },
    "admitted_by_actor_id": { "$ref": "#/$defs/id" },
    "source_authority_actor_id": { "$ref": "#/$defs/id" },
    "source_authority_record_id": { "$ref": "#/$defs/id" },
    "source_authority_record_hash": { "$ref": "#/$defs/sha256" },
    "intentional_export_attestor_id": { "$ref": "#/$defs/id" },
    "intentional_export_attestation_id": { "$ref": "#/$defs/id" },
    "intentional_export_attestation_hash": { "$ref": "#/$defs/sha256" },
    "creative_approver_id": { "$ref": "#/$defs/id" },
    "creative_approval_id": { "$ref": "#/$defs/id" },
    "creative_approval_hash": { "$ref": "#/$defs/sha256" },
    "title_revision_identity_reviewer_id": { "$ref": "#/$defs/id" },
    "title_revision_identity_record_id": { "$ref": "#/$defs/id" },
    "title_revision_identity_record_hash": { "$ref": "#/$defs/sha256" },
    "rights_controller_id": { "$ref": "#/$defs/id" },
    "rights_basis_kind": { "enum": ["AUTHORSHIP_ASSERTION", "SIGNED_ASSIGNMENT", "LICENSE", "PUBLIC_DOMAIN", "OTHER"] },
    "rights_record_id": { "$ref": "#/$defs/id" },
    "rights_record_hash": { "$ref": "#/$defs/sha256" },
    "admitted_evidence": { "$ref": "evidence-envelope.schema.json" },
    "decision": { "const": "ADMIT" },
    "decision_reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "decision_state": { "const": "ADMITTED" },
    "production_gate_effect": { "const": "NONE" },
    "admitted_at_ms": { "$ref": "#/$defs/time" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "time": { "type": "integer", "minimum": 0 }
  }
}
