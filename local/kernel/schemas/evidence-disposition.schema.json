{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hampton.local/v0.3/evidence-disposition.schema.json",
  "title": "Hampton Evidence Disposition v1",
  "description": "A hash-bound terminal lifecycle projection. It never overwrites the immutable evidence envelope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "evidence_hash",
    "evidence_class",
    "scope_aggregate_id",
    "from_state",
    "disposition",
    "replacement_evidence_id",
    "replacement_evidence_hash",
    "invalidated_approval_hashes",
    "gate_recheck_required",
    "effective_at_ms",
    "reason_codes",
    "policy_version",
    "disposition_hash"
  ],
  "properties": {
    "schema_version": {"const": "hampton-evidence-disposition/v1"},
    "evidence_id": {"$ref": "#/$defs/identifier"},
    "evidence_hash": {"$ref": "#/$defs/sha256"},
    "evidence_class": {"$ref": "#/$defs/identifier"},
    "scope_aggregate_id": {"$ref": "#/$defs/identifier"},
    "from_state": {"const": "VERIFIED_CURRENT"},
    "disposition": {"enum": ["SUPERSEDED", "REVOKED", "EXPIRED"]},
    "replacement_evidence_id": {
      "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
    },
    "replacement_evidence_hash": {
      "anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "invalidated_approval_hashes": {
      "description": "Policy-qualified approval envelope hashes permanently invalidated by this required-evidence change. Canonical implementations require lexical ordering.",
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "gate_recheck_required": {
      "description": "Kernel-recomputed flag indicating that this disposition must atomically reevaluate the production gate.",
      "type": "boolean"
    },
    "effective_at_ms": {"$ref": "#/$defs/timestamp_ms"},
    "reason_codes": {
      "description": "Canonical implementations additionally require lexical ordering.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "policy_version": {"$ref": "#/$defs/identifier"},
    "disposition_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"disposition": {"const": "SUPERSEDED"}}},
      "then": {
        "properties": {
          "replacement_evidence_id": {"$ref": "#/$defs/identifier"},
          "replacement_evidence_hash": {"$ref": "#/$defs/sha256"}
        }
      },
      "else": {
        "properties": {
          "replacement_evidence_id": {"type": "null"},
          "replacement_evidence_hash": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^(?!(?:__proto__|constructor|prototype|hasOwnProperty|isPrototypeOf|propertyIsEnumerable|toLocaleString|toString|valueOf|__defineGetter__|__defineSetter__|__lookupGetter__|__lookupSetter__)$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "timestamp_ms": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
