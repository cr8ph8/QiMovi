{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hampton.local/v0.1/verifier-receipt.schema.json",
  "title": "Hampton Verifier Receipt v0.1",
  "description": "A time-bounded attestation bound to exact proposal, base-state, policy, verifier, and receipt bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "verifier_id",
    "verifier_version",
    "proposal_hash",
    "base_state_version",
    "base_state_hash",
    "policy_version",
    "verdict",
    "reason_codes",
    "issued_at_ms",
    "expires_at_ms",
    "receipt_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "hampton-verifier-receipt/v1"
    },
    "receipt_id": {
      "$ref": "#/$defs/identifier"
    },
    "verifier_id": {
      "$ref": "#/$defs/identifier"
    },
    "verifier_version": {
      "$ref": "#/$defs/identifier"
    },
    "proposal_hash": {
      "$ref": "#/$defs/sha256"
    },
    "base_state_version": {
      "$ref": "#/$defs/version"
    },
    "base_state_hash": {
      "$ref": "#/$defs/sha256"
    },
    "policy_version": {
      "$ref": "#/$defs/identifier"
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "REWRITE_REQUIRED"
      ]
    },
    "reason_codes": {
      "description": "Canonical implementations additionally require lexical sort order.",
      "$ref": "#/$defs/reason_codes"
    },
    "issued_at_ms": {
      "$ref": "#/$defs/timestamp_ms"
    },
    "expires_at_ms": {
      "description": "Runtime validation requires this value to be greater than issued_at_ms.",
      "$ref": "#/$defs/timestamp_ms"
    },
    "receipt_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "FAIL",
              "REWRITE_REQUIRED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason_codes": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|constructor|prototype|hasOwnProperty|isPrototypeOf|propertyIsEnumerable|toLocaleString|toString|valueOf|__defineGetter__|__defineSetter__|__lookupGetter__|__lookupSetter__)$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    }
  }
}
