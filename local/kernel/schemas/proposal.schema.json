{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hampton.local/v0.4/proposal.schema.json",
  "title": "Hampton Proposal v0.4",
  "description": "A hash-bound change request. Validation never grants commit authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "actor_id",
    "target_aggregate_id",
    "intent",
    "base_state_version",
    "base_state_hash",
    "delta",
    "evidence_refs",
    "declared_risk",
    "idempotency_key",
    "created_at_ms",
    "expires_at_ms",
    "proposal_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "hampton-proposal/v1"
    },
    "proposal_id": {
      "$ref": "#/$defs/identifier"
    },
    "actor_id": {
      "$ref": "#/$defs/identifier"
    },
    "target_aggregate_id": {
      "$ref": "#/$defs/identifier"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "base_state_version": {
      "$ref": "#/$defs/version"
    },
    "base_state_hash": {
      "$ref": "#/$defs/sha256"
    },
    "delta": {
      "description": "Canonical implementations additionally require op_id sort order and reject duplicate or conflicting targets.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/delta_operation"
      }
    },
    "evidence_refs": {
      "description": "Canonical implementations additionally require lexical sort order.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "declared_risk": {
      "$ref": "#/$defs/risk"
    },
    "idempotency_key": {
      "$ref": "#/$defs/identifier"
    },
    "created_at_ms": {
      "$ref": "#/$defs/timestamp_ms"
    },
    "expires_at_ms": {
      "description": "Runtime validation requires this value to be greater than created_at_ms.",
      "$ref": "#/$defs/timestamp_ms"
    },
    "proposal_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^(?!(?:__proto__|constructor|prototype|hasOwnProperty|isPrototypeOf|propertyIsEnumerable|toLocaleString|toString|valueOf|__defineGetter__|__defineSetter__|__lookupGetter__|__lookupSetter__)$)[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "fact_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ]
    },
    "json_value": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        { "type": "string" },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/json_value"
          }
        },
        {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "$ref": "#/$defs/json_value"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "expected_target_hash": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "const": "ABSENT"
        }
      ]
    },
    "upsert_fact_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/json_value"
        }
      }
    },
    "set_lifecycle_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "production_gate_evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "blockers",
        "satisfied_evidence_classes",
        "evidence_hashes",
        "policy_version",
        "policy_hash",
        "next_recheck_at_ms"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOT_EVALUATED",
            "BLOCKED",
            "REVIEW_REQUIRED",
            "APPROVED",
            "REVOKED",
            "EXPIRED"
          ]
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "satisfied_evidence_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "evidence_hashes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/sha256" }
        },
        "policy_version": { "$ref": "#/$defs/identifier" },
        "policy_hash": { "$ref": "#/$defs/sha256" },
        "next_recheck_at_ms": {
          "anyOf": [
            { "$ref": "#/$defs/timestamp_ms" },
            { "type": "null" }
          ]
        }
      }
    },
    "delta_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op_id",
        "kind",
        "target",
        "expected_target_hash",
        "payload"
      ],
      "properties": {
        "op_id": {
          "$ref": "#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "UPSERT_FACT",
            "REMOVE_FACT",
            "SET_LIFECYCLE",
            "LINK_EVIDENCE",
            "UNLINK_EVIDENCE",
            "RECORD_EVIDENCE_DISPOSITION",
            "EVALUATE_PRODUCTION_GATE",
            "APPLY_ARTIFACT_IMPACTS",
            "MIGRATE_TITLE_STATE",
            "RECORD_ARTIFACT_INSTANCE",
            "ADMIT_SOURCE_REVISION"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "expected_target_hash": {
          "$ref": "#/$defs/expected_target_hash"
        },
        "payload": {
          "$ref": "#/$defs/json_value"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "UPSERT_FACT",
                  "REMOVE_FACT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/fact_id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "RECORD_EVIDENCE_DISPOSITION"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/identifier"
              },
              "payload": {
                "$ref": "evidence-disposition.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "UPSERT_FACT"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/upsert_fact_payload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "REMOVE_FACT"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "SET_LIFECYCLE"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "const": "lifecycle"
              },
              "payload": {
                "$ref": "#/$defs/set_lifecycle_payload"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "LINK_EVIDENCE",
                  "UNLINK_EVIDENCE"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "$ref": "#/$defs/identifier"
              },
              "payload": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "EVALUATE_PRODUCTION_GATE"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "const": "production"
              },
              "payload": {
                "$ref": "#/$defs/production_gate_evaluation"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "APPLY_ARTIFACT_IMPACTS"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "const": "artifact_impacts"
              },
              "payload": {
                "$ref": "artifact-impact.schema.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "MIGRATE_TITLE_STATE"}}
          },
          "then": {
            "properties": {
              "target": {"const": "schema_version"},
              "payload": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from_schema_version", "to_schema_version"],
                "properties": {
                  "from_schema_version": {"const": "filmstack-title-state/v2"},
                  "to_schema_version": {"const": "filmstack-title-state/v3"}
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "RECORD_ARTIFACT_INSTANCE"}}
          },
          "then": {
            "properties": {
              "target": {"$ref": "#/$defs/identifier"},
              "payload": {"$ref": "artifact-instance.schema.json"}
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "ADMIT_SOURCE_REVISION"}}
          },
          "then": {
            "properties": {
              "target": {"const": "source.revision"},
              "expected_target_hash": {"const": "ABSENT"},
              "payload": {"$ref": "source-admission-record.schema.json"}
            }
          }
        }
      ]
    }
  }
}
