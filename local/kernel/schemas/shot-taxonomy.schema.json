{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.hampton.local/v0.4/shot-taxonomy.schema.json",
  "title": "FilmStack Shot Taxonomy v1",
  "description": "The closed, eight-dimension production-planning vocabulary source. Validation proves structural consistency and vocabulary identity, not creative, safety, rights, or production authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "updated_on",
    "boundary",
    "source_reference",
    "category_order",
    "categories",
    "reference_mapping",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": "filmstack-shot-taxonomy/v1" },
    "taxonomy_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "updated_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "boundary": { "$ref": "#/$defs/nonempty_text" },
    "source_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "description", "reference_count"],
      "properties": {
        "label": { "$ref": "#/$defs/nonempty_text" },
        "description": { "$ref": "#/$defs/nonempty_text" },
        "reference_count": { "type": "integer", "minimum": 1, "maximum": 1000 }
      }
    },
    "category_order": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        { "const": "SHOT_SIZE" },
        { "const": "CAMERA_ANGLE" },
        { "const": "COMPOSITION" },
        { "const": "CAMERA_MOVEMENT" },
        { "const": "SUPPORT_RIG" },
        { "const": "FOCUS_OPTICAL" },
        { "const": "COVERAGE_PURPOSE" },
        { "const": "CAPTURE_MODE" }
      ],
      "items": false
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SHOT_SIZE",
        "CAMERA_ANGLE",
        "COMPOSITION",
        "CAMERA_MOVEMENT",
        "SUPPORT_RIG",
        "FOCUS_OPTICAL",
        "COVERAGE_PURPOSE",
        "CAPTURE_MODE"
      ],
      "properties": {
        "SHOT_SIZE": { "$ref": "#/$defs/category" },
        "CAMERA_ANGLE": { "$ref": "#/$defs/category" },
        "COMPOSITION": { "$ref": "#/$defs/category" },
        "CAMERA_MOVEMENT": { "$ref": "#/$defs/category" },
        "SUPPORT_RIG": { "$ref": "#/$defs/category" },
        "FOCUS_OPTICAL": { "$ref": "#/$defs/category" },
        "COVERAGE_PURPOSE": { "$ref": "#/$defs/category" },
        "CAPTURE_MODE": { "$ref": "#/$defs/category" }
      }
    },
    "reference_mapping": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/reference_mapping" }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "nonempty_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "category_name": {
      "enum": [
        "SHOT_SIZE",
        "CAMERA_ANGLE",
        "COMPOSITION",
        "CAMERA_MOVEMENT",
        "SUPPORT_RIG",
        "FOCUS_OPTICAL",
        "COVERAGE_PURPOSE",
        "CAPTURE_MODE"
      ]
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "entries"],
      "properties": {
        "label": { "$ref": "#/$defs/nonempty_text" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "value", "definition", "aliases", "supplied_refs"],
      "properties": {
        "code": { "$ref": "#/$defs/code" },
        "value": { "$ref": "#/$defs/nonempty_text" },
        "definition": { "$ref": "#/$defs/nonempty_text" },
        "aliases": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonempty_text" }
        },
        "supplied_refs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 1000 }
        }
      }
    },
    "reference_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_number", "supplied_term", "category", "code", "clarification"],
      "properties": {
        "reference_number": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "supplied_term": { "$ref": "#/$defs/nonempty_text" },
        "category": { "$ref": "#/$defs/category_name" },
        "code": { "$ref": "#/$defs/code" },
        "clarification": { "$ref": "#/$defs/nonempty_text" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url"],
      "properties": {
        "label": { "$ref": "#/$defs/nonempty_text" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" }
      }
    }
  }
}
